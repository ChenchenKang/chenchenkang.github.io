<div class="news">
  {% if site.news != blank %}

    {% assign news = site.news | sort: 'date' | reverse %}
    {% assign news_size = news | size %}

    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}

    {% if include.limit %}

      <!-- Compact layout for announcements on other pages -->
      <div
        class="table-responsive"
        {% if page.announcements.scrollable and news_size > 3 %}
          style="max-height: 60vw"
        {% endif %}
      >
        <table class="table table-sm table-borderless">
          {% for item in news limit: news_limit %}
            <tr>
              <th scope="row" style="width: 20%">
                {{ item.date | date: '%b %d, %Y' }}
              </th>

              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">
                    {{ item.title }}
                  </a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </table>
      </div>

    {% else %}

      <!-- Full layout for the standalone News page -->
      {% assign current_year = site.time | date: '%Y' %}
      {% assign news_by_year = news | group_by_exp: 'item', "item.date | date: '%Y'" %}
      {% assign news_by_year = news_by_year | sort: 'name' | reverse %}

      <div class="news-years">

        {% for year_group in news_by_year %}
          {% assign year_count = year_group.items | size %}

          {% if year_group.name == current_year %}

            <!-- Current year: open and fully displayed -->
            <section class="news-year news-year--current">
              <h2 class="news-year-heading">
                News in {{ year_group.name }}
              </h2>

              <div class="news-list">
                {% for item in year_group.items %}

                  <article class="news-entry{% unless item.image %} news-entry--no-image{% endunless %}">

                    <div class="news-entry-content">
                      <time
                        class="news-entry-date"
                        datetime="{{ item.date | date_to_xmlschema }}"
                      >
                        {{ item.date | date: '%B %d, %Y' }}
                      </time>

                      {% if item.title %}
                        <h3 class="news-entry-title">
                          {% if item.link %}
                            <a href="{{ item.link }}">
                              {{ item.title }}
                            </a>
                          {% elsif item.inline %}
                            {{ item.title }}
                          {% else %}
                            <a href="{{ item.url | relative_url }}">
                              {{ item.title }}
                            </a>
                          {% endif %}
                        </h3>
                      {% endif %}

                      <div class="news-entry-summary">
                        {% if item.summary %}
                          {{ item.summary | markdownify }}
                        {% elsif item.inline %}
                          {{ item.content | emojify }}
                        {% else %}
                          {{ item.excerpt | strip_html | truncatewords: 55 }}
                        {% endif %}
                      </div>

                      {% if item.link %}
                        <a class="news-entry-link" href="{{ item.link }}">
                          Read more <span aria-hidden="true">&rarr;</span>
                        </a>
                      {% elsif item.inline != true %}
                        <a class="news-entry-link" href="{{ item.url | relative_url }}">
                          Read more <span aria-hidden="true">&rarr;</span>
                        </a>
                      {% endif %}
                    </div>

                    {% if item.image %}
                      <figure class="news-entry-image news-entry-image--{{ item.image_size | default: 'medium' }}">
                        {% if item.link %}
                          <a href="{{ item.link }}">
                            <img
                              src="{{ item.image | relative_url }}"
                              alt="{{ item.image_alt | default: item.title | escape }}"
                              loading="lazy"
                            >
                          </a>
                        {% elsif item.inline %}
                          <img
                            src="{{ item.image | relative_url }}"
                            alt="{{ item.image_alt | default: item.title | escape }}"
                            loading="lazy"
                          >
                        {% else %}
                          <a href="{{ item.url | relative_url }}">
                            <img
                              src="{{ item.image | relative_url }}"
                              alt="{{ item.image_alt | default: item.title | escape }}"
                              loading="lazy"
                            >
                          </a>
                        {% endif %}

                        {% if item.image_caption %}
                          <figcaption>
                            {{ item.image_caption }}
                          </figcaption>
                        {% endif %}
                      </figure>
                    {% endif %}

                  </article>

                {% endfor %}
              </div>
            </section>

          {% else %}

            <!-- Previous year: collapsed until clicked -->
            <details class="news-year news-year--archive">
              <summary class="news-year-summary">
                <span class="news-year-summary-title">
                  News in {{ year_group.name }}
                </span>

                <span class="news-year-count">
                  {{ year_count }}
                  {% if year_count == 1 %}
                    entry
                  {% else %}
                    entries
                  {% endif %}
                </span>
              </summary>

              <div class="news-list news-year-list">
                {% for item in year_group.items %}

                  <article class="news-entry{% unless item.image %} news-entry--no-image{% endunless %}">

                    <div class="news-entry-content">
                      <time
                        class="news-entry-date"
                        datetime="{{ item.date | date_to_xmlschema }}"
                      >
                        {{ item.date | date: '%B %d, %Y' }}
                      </time>

                      {% if item.title %}
                        <h3 class="news-entry-title">
                          {% if item.link %}
                            <a href="{{ item.link }}">
                              {{ item.title }}
                            </a>
                          {% elsif item.inline %}
                            {{ item.title }}
                          {% else %}
                            <a href="{{ item.url | relative_url }}">
                              {{ item.title }}
                            </a>
                          {% endif %}
                        </h3>
                      {% endif %}

                      <div class="news-entry-summary">
                        {% if item.summary %}
                          {{ item.summary | markdownify }}
                        {% elsif item.inline %}
                          {{ item.content | emojify }}
                        {% else %}
                          {{ item.excerpt | strip_html | truncatewords: 55 }}
                        {% endif %}
                      </div>

                      {% if item.link %}
                        <a class="news-entry-link" href="{{ item.link }}">
                          Read more <span aria-hidden="true">&rarr;</span>
                        </a>
                      {% elsif item.inline != true %}
                        <a class="news-entry-link" href="{{ item.url | relative_url }}">
                          Read more <span aria-hidden="true">&rarr;</span>
                        </a>
                      {% endif %}
                    </div>

                    {% if item.image %}
                      <figure class="news-entry-image news-entry-image--{{ item.image_size | default: 'medium' }}">
                        {% if item.link %}
                          <a href="{{ item.link }}">
                            <img
                              src="{{ item.image | relative_url }}"
                              alt="{{ item.image_alt | default: item.title | escape }}"
                              loading="lazy"
                            >
                          </a>
                        {% elsif item.inline %}
                          <img
                            src="{{ item.image | relative_url }}"
                            alt="{{ item.image_alt | default: item.title | escape }}"
                            loading="lazy"
                          >
                        {% else %}
                          <a href="{{ item.url | relative_url }}">
                            <img
                              src="{{ item.image | relative_url }}"
                              alt="{{ item.image_alt | default: item.title | escape }}"
                              loading="lazy"
                            >
                          </a>
                        {% endif %}

                        {% if item.image_caption %}
                          <figcaption>
                            {{ item.image_caption }}
                          </figcaption>
                        {% endif %}
                      </figure>
                    {% endif %}

                  </article>

                {% endfor %}
              </div>
            </details>

          {% endif %}

        {% endfor %}

      </div>

    {% endif %}

  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
